# Hexmark configuration. Copy to .env and adjust.
# Docker Compose reads .env from the repository root; `pnpm dev` loads the
# same file for the server and the web app.

# Image tag pulled by compose.yaml (e.g. 1.2.3, 1.2 or latest).
HEXMARK_VERSION=latest

# PostgreSQL credentials used by the db service and passed to the server.
POSTGRES_USER=hexmark
# Required: both compose files refuse to start without it. Generate one with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
# PostgreSQL applies it only when the database volume is first created;
# changing it later does not change the password of an existing database.
POSTGRES_PASSWORD=
POSTGRES_DB=hexmark

# Host ports published by Docker Compose (defaults 3001 and 3000).
SERVER_PORT=3001
WEB_PORT=3000
# compose.dev.yaml only: PostgreSQL on 127.0.0.1 (default 5432). `pnpm dev`
# connects the server to this port on localhost.
DB_PORT=5432

# Instance keys. Required: both compose files refuse to start without them,
# and `pnpm dev` refuses setup and sign-in until they are valid. Each is 32
# random bytes in base64url (exactly 43 characters). Generate each one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# or
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# INTERNAL_API_KEY lets the API server trust the browser addresses the web
# server forwards; changing it is harmless (restart both containers).
INTERNAL_API_KEY=
# ENCRYPTION_KEY encrypts secrets stored in the database (e.g. two-factor
# secrets). Back it up together with the database: if it is lost, that data
# cannot be decrypted any more. To replace it, move the old value to
# ENCRYPTION_KEY_PREVIOUS (decrypt only) and set a new ENCRYPTION_KEY.
ENCRYPTION_KEY=
# ENCRYPTION_KEY_PREVIOUS=

# Optional: reverse proxies in front of the web app whose X-Forwarded-For and
# X-Forwarded-Proto headers are believed, as comma-separated addresses or
# CIDR ranges (IPv4 and IPv6). Empty: none. Optionally one header a trusted
# proxy sets to the client address (e.g. CF-Connecting-IP). See
# docs/deployment.md.
# TRUSTED_PROXIES=
# TRUSTED_PROXY_HEADER=

# Optional: the address users open Hexmark at in the browser, as an origin
# (scheme, host and optional port, no path), e.g. https://wiki.example.com.
# Needed for security keys and passkeys (WebAuthn) as a second factor:
# browsers allow them only on https:// or on http://localhost, and the keys
# are bound to this host name, so changing it later makes registered keys
# stop working. Without it (or with an invalid value, which is logged at
# start-up) security keys are not offered; authenticator apps work anyway.
# Local development: PUBLIC_ORIGIN=http://localhost:3000
# PUBLIC_ORIGIN=

# Optional: the address MCP clients (agents) use for the server's /mcp
# endpoint, an absolute http(s) URL ending in /mcp. Shown in the client
# configuration after creating an API token. Without it the web app builds the
# address from the host the browser uses and SERVER_PORT. See docs/mcp.md.
# MCP_PUBLIC_URL=https://wiki.example.com/mcp

# Optional: reading budget per note section in estimated tokens (default
# 8000). Larger sections are marked in the outline and writes suggest
# splitting them; nothing is refused.
# SECTION_TOKEN_BUDGET=8000

# Optional: how many days deleted notes and folders stay in the trash before
# the server deletes them for good (default 28, 1 to 3650). Something deleted
# at a given time is purged once that many days have passed (with 28: on day
# 29); the server checks at start and then every hour.
# TRASH_RETENTION_DAYS=28

# Optional: how many days the audit log keeps its events (default 365, 1 to
# 3650). The server deletes older events at start and then every hour. See
# docs/audit.md.
# AUDIT_RETENTION_DAYS=365

# One-time token for creating the first admin at /setup.
# Exactly 8 characters, A-Z and 0-9 (surrounding spaces and lower case are
# accepted and normalised). Generate one with:
#   LC_ALL=C tr -dc 'A-Z0-9' < /dev/urandom | head -c 8; echo
# Remove it after setup and restart the server: login is refused while it is set.
SETUP_TOKEN=

# Optional: lifetimes of browser sign-ins. Format: a whole number followed by
# s, m, h or d (e.g. 30m, 12h, 28d). Leave unset for the defaults shown.
# "Remember me" unchecked: the cookie ends with the browser session, and the
# session also ends after SESSION_IDLE_TIMEOUT without a request.
# "Remember me" checked: the cookie survives browser restarts and there is no
# idle limit. Every session ends SESSION_MAX_AGE after sign-in, either way.
# Out-of-range values are logged at start-up and replaced by the defaults.
# Session ID is replaced after this much activity (1m-1h, below the idle timeout):
# SESSION_ROTATION=5m
# Sign-out after inactivity without "remember me" (5m-7d):
# SESSION_IDLE_TIMEOUT=1h
# Absolute limit from sign-in, also with "remember me" (1h-365d):
# SESSION_MAX_AGE=28d
