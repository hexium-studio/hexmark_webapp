# Hexmark configuration. Copy to .env and adjust.
# Docker Compose reads .env from the repository root; the server reads
# DATABASE_URL, PORT and SETUP_TOKEN when it runs outside Docker.

# Image tag pulled by compose.yaml (e.g. 1.2.3, 1.2 or latest).
HEXMARK_VERSION=latest

# PostgreSQL credentials used by the db service and passed to the server.
# compose.yaml refuses to start without POSTGRES_PASSWORD.
POSTGRES_USER=hexmark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hexmark

# Host ports published by Docker Compose (defaults 3001 and 3000).
SERVER_PORT=3001
WEB_PORT=3000
# compose.dev.yaml only: PostgreSQL on 127.0.0.1 (default 5432).
DB_PORT=5432

# Server outside Docker only (pnpm dev): connection URL and HTTP port.
# Inside Docker Compose both are set by the compose file.
DATABASE_URL=postgres://hexmark:change-me@localhost:5432/hexmark
PORT=3001

# One-time token for creating the first admin (not used yet).
# Exactly 16 characters, A-Z and 0-9. Generate one with:
#   LC_ALL=C tr -dc 'A-Z0-9' < /dev/urandom | head -c 16; echo
SETUP_TOKEN=
