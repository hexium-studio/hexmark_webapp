# Hexmark configuration. Copy to .env and adjust.
# Docker Compose reads .env from the repository root; `pnpm dev` loads the
# same file for the server and the web app.

# Image tag pulled by compose.yaml (e.g. 1.2.3, 1.2 or latest).
HEXMARK_VERSION=latest

# PostgreSQL credentials used by the db service and passed to the server.
POSTGRES_USER=hexmark
# Required: both compose files refuse to start without it. Generate one with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
# PostgreSQL applies it only when the database volume is first created;
# changing it later does not change the password of an existing database.
POSTGRES_PASSWORD=
POSTGRES_DB=hexmark

# Host ports published by Docker Compose (defaults 3001 and 3000).
SERVER_PORT=3001
WEB_PORT=3000
# compose.dev.yaml only: PostgreSQL on 127.0.0.1 (default 5432). `pnpm dev`
# connects the server to this port on localhost.
DB_PORT=5432

# One-time token for creating the first admin at /setup.
# Exactly 8 characters, A-Z and 0-9 (surrounding spaces and lower case are
# accepted and normalised). Generate one with:
#   LC_ALL=C tr -dc 'A-Z0-9' < /dev/urandom | head -c 8; echo
# Remove it after setup and restart the server: login is refused while it is set.
SETUP_TOKEN=
